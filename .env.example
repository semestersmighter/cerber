# Base de données
POSTGRES_USER=cerber_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cerber_db
DATABASE_URL=postgresql://cerber_admin:change_me@db:5432/cerber_db

# Durées (minutes) et verrouillage
SESSION_MINUTES=60
MFA_CHALLENGE_MINUTES=5
LOCK_MINUTES=15
MAX_LOGIN_ATTEMPTS=5

# ---- Nom d'hôte public ----
# En-tête qui donne le nom d'hôte public :
#   host              accès direct au portail (par défaut)
#   x-forwarded-host  CERBER est derrière un autre reverse proxy qui renseigne X-Forwarded-Host
HOST_HEADER=host
# Noms d'hôte acceptés, séparés par des virgules ("*" = tous, "*.exemple.fr" = sous-domaines).
# Tout autre hôte est refusé (421 par nginx, 400 par le backend et les services).
ALLOWED_HOSTS=localhost,127.0.0.1

# Ports publiés sur la machine hôte (HTTPS_PORT sert aussi à la redirection HTTP -> HTTPS)
HTTP_PORT=8080
HTTPS_PORT=8443

# Cookies Secure (HTTPS). Ne mettre false que pour un test local en HTTP.
COOKIE_SECURE=true

# Nom affiché dans l'application TOTP
TOTP_ISSUER=CERBER

# Images Docker (GitHub Container Registry). CERBER_TAG : latest (branche main), 1.2.0 (version), sha-abc1234
CERBER_REGISTRY=ghcr.io/semestersmighter
CERBER_TAG=latest
